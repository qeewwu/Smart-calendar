{
  "name": "smart-calendar",
  "version": "0.1.2",
  "description": "Умный календарь для Obsidian: ежедневные, недельные, месячные, квартальные и годовые заметки, автошаблоны и авто-раскладка по папкам.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
